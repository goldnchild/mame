<color red="0.10" blue="0.10" green="0.10" />
</text >
<text string="150" state="6" >
<color red="0.10" blue="0.10" green="0.10" />
</text >
<text string="75" state="7" >
<color red="0.10" blue="0.10" green="0.10" />
</text >

</element>

