<mamelayout version="2">

<!-- define elements -->

<element name="whiterect">
<rect>
	<color red="1.0" blue="1.0" green="1.0" />
	<bounds left="0.0" top="0.0" right="1.0" bottom="1.0" />
</rect>
</element>

<element name="button">
	<rect state="0">
		    <color red="0.5" green="0.5" blue="0.5" />
	</rect>
	<rect state="1">
		    <color red="0.7" green="1.0" blue="1.0" />
	</rect>
</element>

<element name="led">
	<disk>
	<bounds left="0.0" top="0.0" bottom="1.0" right="1.0" />
		    <color red="0.0" green="0.0" blue="0.0" />
	</disk>
	<disk state="0">
	<bounds left="0.1" top="0.1" bottom="0.9" right="0.9" />
		    <color red="0.2" green="0.2" blue="0.2" />
	</disk>
	<disk state="1">
	<bounds left="0.1" top="0.1" bottom="0.9" right="0.9" />
		    <color red="0.7" green="0.3" blue="0.3" />
	</disk>
</element>

 <element name="onled">
	<disk>
	<bounds left="0.0" top="0.0" bottom="1.0" right="1.0" />
		    <color red="0.0" green="0.0" blue="0.0" />
	</disk>
	<disk>
	<bounds left="0.1" top="0.1" bottom="0.9" right="0.9" />
		    <color red="0.7" green="0.3" blue="0.3" />
	</disk>
</element>

<element name="switch0bottom">
	 <rect>
	 <bounds left="0.0" top="0.0" bottom="1.0" right="1.0" />
		        <color red="0.75" green="0.75" blue="0.75" />
		</rect>
		<rect>
		<bounds left="0.1" top="0.1" bottom="0.9" right="0.9" />
		        <color red="0.2" green="0.2" blue="0.2" />
		</rect>
		<rect>
		<bounds state="1" left="0.15" top="0.15" bottom="0.5" right="0.85" />   <!-- 1 is on the bottom -->
		<bounds state="0" left="0.15" top="0.5" bottom="0.85" right="0.85" />   <!-- 0 is on the bottom -->
		        <color red="0.75" green="0.75" blue="0.75" />
		</rect>
</element>

