	PORT_DIPSETTING(0x01, "4800")
	PORT_DIPSETTING(0x02, "2400")
	PORT_DIPSETTING(0x03, "1200")
	PORT_DIPSETTING(0x04, "600")
	PORT_DIPSETTING(0x05, "300")
	PORT_DIPSETTING(0x06, "150")
	PORT_DIPSETTING(0x07, "75")
-->
