</group>



<group name="pc6022panel" >

	<element ref="whiterect">
	  <bounds left="5" top="5" right="95" bottom="30" />
	  <color red="0.8" blue="0.8" green="0.8" alpha="0.20" />
	</element>

	<element ref="keycap" inputtag=":centronics:pc6022:PB" inputmask="1">  <!-- right -->
		    <bounds x="82" y="12" width="4" height="4" />
	</element>
	<element ref="textright">  <!-- up -->
		    <bounds x="82" y="12" width="4" height="4" />
		    <color red="0.0" blue="0.0" green="0.0" />
	</element>
	<element ref="keycap" inputtag=":centronics:pc6022:PB" inputmask="2"> <!-- left -->
		    <bounds x="72" y="12" width="4" height="4" />
	</element>
	<element ref="textleft">  <!-- up -->
		    <bounds x="72" y="12" width="4" height="4" />
		    <color red="0.0" blue="0.0" green="0.0" />
	</element>
	<element ref="keycap" inputtag=":centronics:pc6022:PB" inputmask="4"> <!-- down -->
		    <bounds x="77" y="18" width="4" height="4" />
	</element>
	<element ref="textdown">  <!-- up -->
		    <bounds x="77" y="18" width="4" height="4" />
		    <color red="0.0" blue="0.0" green="0.0" />
	</element>
	<element ref="keycap" inputtag=":centronics:pc6022:PB" inputmask="8"><!-- up -->
		   <bounds x="77" y="6" width="4" height="4" />
	</element>
	<element ref="textup">  <!-- up -->
		    <bounds x="77" y="6" width="4" height="4" />
			<color red="0.0" blue="0.0" green="0.0" />
	</element>

	<element ref="keycap2" inputtag=":centronics:pc6022:PC" inputmask="2"><!-- stop button -->
		    <bounds x="21" y="20" width="4" height="4" />
		    <color red="0.8" blue="0.3" green="0.3" />
	</element>
	<element ref="textstop">
		    <bounds x="18" y="25" width="10" height="2" />
		    <color red="0.0" blue="0.0" green="0.0" />
	</element>

	<element ref="led" name="stop_led"><!-- stop_led -->
		      <bounds x="27" y="21" width="2.5" height="2.5" />
	</element>
	<element ref="onled" name="power_led"><!-- power_led -->
		      <bounds x="10" y="21" width="2.5" height="2.5" />
	</element>
    <element ref="textpower">
		    <bounds x="6" y="25" width="10" height="2" />
		    <color red="0.0" blue="0.0" green="0.0" />
	</element>

	<element ref="keycap" inputtag=":centronics:pc6022:PB" inputmask="0x40"><!-- color change -->
		<bounds x="57" y="20" width="4" height="4" />
	</element>

	<element ref="textcc">
		    <bounds x="56" y="25" width="6" height="2" />
		    <color red="0.0" blue="0.0" green="0.0" />
	</element>

	<element ref="keycap" inputtag=":centronics:pc6022:PB" inputmask="0x80"><!-- pen change -->
		<bounds x="63" y="20" width="4" height="4" />
	</element>

	<element ref="textpc">
		    <bounds x="62" y="25" width="6" height="2" />
		    <color red="0.0" blue="0.0" green="0.0" />
	</element>

	<element ref="switch0bottom" inputtag=":centronics:pc6022:PB" inputmask="0x10"><!-- step -->
		<bounds x="36" y="20" width="4" height="4" />
	</element>

	<element ref="textstep2">
	    <bounds x="35.5" y="17" width="5" height="2" />
	    <color red="0.0" blue="0.0" green="0.0" />
	</element>

	<element ref="textstep1">
	    <bounds x="35.5" y="25" width="5" height="2" />
	    <color red="0.0" blue="0.0" green="0.0" />
	</element>

	<element ref="switch0bottom" inputtag=":centronics:pc6022:PB" inputmask="0x20"><!-- kata/hira -->
		<bounds x="43" y="20" width="4" height="4" />
	</element>

	<element ref="texthira">
	    <bounds x="42.5" y="17" width="5" height="2" />
	    <color red="0.0" blue="0.0" green="0.0" />
	</element>


	<element ref="textkata">
	    <bounds x="42.5" y="25" width="5" height="2" />
	    <color red="0.0" blue="0.0" green="0.0" />
	</element>

	<element ref="button" inputtag=":centronics:pc6022:PC" inputmask="0x80"><!-- pen sensor -->
            <bounds left="5" top="5" right="6"  bottom="6" />
    </element>
    <element ref="counter" name="pen_color"><!-- pen sensor -->
            <bounds left="10" top="5" right="15"  bottom="9" />
            <color red="0.0" blue="0.0" green="0.0" />
    </element>
        <element ref="pencolor" name="pen_color"><!-- pen sensor -->
            <bounds left="19" top="5" right="26"  bottom="9" />
            <color red="0.0" blue="0.0" green="0.0" />
    </element>
</group>


<view name="PC6022 Layout">
	<bounds left="0" right="200" top="0" bottom="100" />

	<screen tag=":screen">
	   <bounds left="0" top="0" right="100" bottom="100" />
	</screen>

	<screen tag=":centronics:pc6022:bitmap_printer:screen">
	   <bounds left="100" top="0" right="200" bottom="100" />
	</screen>

	<group ref="pc6022panel">
	<bounds top="0" left="100" right="200" bottom="30" />
	</group>
	
	<group ref="pens">
	<bounds top="1" left="140" right="150" bottom="11" />
	</group>
</view>
</mamelayout>

