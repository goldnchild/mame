</element>

<element name="textleft" >
<text string="&#x2190;" >
</text>
</element>

<element name="textup" >
<text string="&#x2191;" >
</text>
</element>

<element name="textright" >
<text string="&#x2192;" >
</text>
</element>

<element name="textdown" >
<text string="&#x2193;" >
</text>
</element>


<element name="textstop" >
<text string="STOP" >
</text>
</element>

<element name="textpower" >
<text string="POWER" >
</text>
</element>

<element name="textcc" >
<text string="CC" >
</text>
</element>

<element name="textpc" >
<text string="PC" >
</text>
</element>

<element name="textstep1" >
<text string="STEP1" >
</text>
</element>

<element name="textstep2" >
<text string="STEP2" >
</text>
</element>

<!-- ひら が な / カ タカ ナ -->
<!-- Hiragana / Katakana-->
<element name="texthira" >
<text string="HIRA" > <!--"ひらがな" -->
</text>
</element>

<element name="textkata" >
<text string="KATA" > <!--"カタカナ" -->
</text>
</element>

<element name="counter" >
<simplecounter digits="1"/>
</element>

<element name="pencolor" >
<text state="0" string="Black">
</text>
<text state="1" string="Blue">
</text>
<text state="2" string="Green">
</text>
<text state="3" string="Red">
</text>
</element>

<element name="pen0" >
<disk>
<color red="0.0" green="0.0" blue="0.0" />
</disk>
</element>

<element name="pen1" >
<disk>
<color red="0.0" green="0.0" blue="1.0" />
</disk>
</element>

<element name="pen2" >
<disk>
<color red="0.0" green="1.0" blue="0.0" />
</disk>
</element>

<element name="pen3" >
<disk>
<color red="1.0" green="0.0" blue="0.0" />
</disk>
</element>

<!--
rotating pens generated from the following lua script
cr = "\n"
function otag(t,attrs) attrs=attrs or "" return "<"..t.." "..attrs..">" end
function stag(t,attrs) attrs=attrs or "" return "<"..t.." "..attrs.."/>" end
function attr(k,v) return k..'="'..v..'" ' end
function ctag(t) return '</'..t..'>' end
function strnil(s) if not s then return "" else return s end end
function torad(d) return d/180*math.pi end
out=""
cylsize=4
radius=cylsize+1
for col=0,3 do
out=out..otag("element", attr("ref","pen"..col)..attr("name","pen_pos"))..cr
for rotpos=0,11 do
x0 = 10
y0 = 10
ang = rotpos * (360/12) + (-col+1) * (360/4)
xc = x0+math.cos(torad(ang))*radius
yc = y0-math.sin(torad(ang))*radius
out=out..stag("bounds", attr("state",rotpos)..attr("xc",xc)..attr("yc",yc)..attr("width",cylsize)..attr("height",cylsize))..cr
end
out=out..ctag("element")..cr..cr
end
print(out)
-->

<group name="pens">
<element ref="pen0" name="pen_pos" >
<bounds state="0" xc="10.0" yc="5.0" width="4" height="4" />
<bounds state="1" xc="7.5" yc="5.6698729810778" width="4" height="4" />
<bounds state="2" xc="5.6698729810778" yc="7.5" width="4" height="4" />
